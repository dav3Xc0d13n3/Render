services:
  - type: web
    name: ollie-vps
    runtime: docker
    dockerfilePath: ./Dockerfile
    plan: free
    envVars:
      - key: SSH_PUBLIC_KEY
        sync: false          # paste your Termux public key in the dashboard
      - key: GIT_SNAPSHOT_REPO
        sync: false          # e.g. "yourname/ollie-snapshot"
      - key: GIT_SNAPSHOT_TOKEN
        sync: false          # fine-grained PAT, repo write
